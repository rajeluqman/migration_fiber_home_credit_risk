ENV=dev
FABRIC_WORKSPACE_ID=your-fabric-workspace-guid
FABRIC_LAKEHOUSE_ID=your-fabric-lakehouse-guid
AZURE_TENANT_ID=your-azure-tenant-guid
AZURE_CLIENT_ID=your-service-principal-app-id
AZURE_CLIENT_SECRET=your-service-principal-secret
ONELAKE_ENDPOINT=https://onelake.dfs.fabric.microsoft.com
# Slack Incoming Webhook for pipeline-failure alerting (ADR-013). Real value from a Slack app's
# "Incoming Webhooks" page; format: https://hooks.slack.com/services/<T...>/<B...>/<token>
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url
KAGGLE_API_TOKEN=your-kaggle-api-key
KAGGLE_COMPETITION=home-credit-default-risk
